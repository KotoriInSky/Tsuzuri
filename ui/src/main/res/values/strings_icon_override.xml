<?xml version="1.0" encoding="utf-8"?>
<!--
  「自定义图标写盘链路」这一轮修复新增的文案（Agent A 独占）。

  为什么单独一个文件：见 strings_fan_shortcut.xml 顶部那条理由（同一份 strings.xml
  由多个人同时改必然互相覆盖，而且两边的构建都是过的）。

  资源名 = i18n 键里把点换成下划线（见 ui/.../Strings.kt）。

  文案规则：标题是名词短语、≤ 6 字；说明 ≤ 20 字；只说「是什么 / 做什么」；
  不写「为什么」、不写实施细节、不用括号补第二句。

  这一组文案的用途只有一个：**写盘失败时必须说出来**。
  上一版失败是静默的（返回 null，界面只会说一句笼统的「没换上」），
  而用户看到的「图标还是没变」有可能发生在四个完全不同的环节上 ——
  所以这里的四句按**环节**分开，界面上那句话与日志里那行对得上。
-->
<resources>

    <!-- ── 裁剪页：写盘结果 ──────────────────────────────────────── -->
    <!-- 选中的那张图读不出来（URI 失效 / 不是图片）：用户唯一能做的是回去重选 -->
    <string name="fan_icon_crop_failed_decode">无法读取这张图片，请返回重选</string>
    <!-- 图片处理（裁剪 / 缩放 / 编码 PNG）失败：换一张更常规的图通常就好 -->
    <string name="fan_icon_crop_failed_encode">图片处理失败，请更换图片</string>
    <!-- 落盘失败：目录建不出来、磁盘满、权限被拒 -->
    <string name="fan_icon_crop_failed_write">保存失败，存储写不进去</string>
    <!-- 写完之后自校验没过（字节数不符 / 文件消失了）—— 这一句只说「再试一次」，
         因为能做的动作确实只有重试与取消，具体原因在日志里 -->
    <string name="fan_icon_crop_failed_verify">保存没成功，请再试一次</string>
    <!-- 保存中：确认之后要写盘，这期间按钮不该能被再点一次（会重复写） -->
    <string name="fan_icon_crop_saving">正在保存…</string>

</resources>
